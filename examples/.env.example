# migra 环境变量配置示例
# 使用 MIGRA_ 前缀（参考 https://pkg.go.dev/github.com/spf13/viper#SetEnvPrefix）
# 注意：.env 文件中的值不需要引号包裹，除非值中包含空格
#
# 配置优先级（从高到低）：
#   命令行参数 > 环境变量(MIGRA_*) > 配置文件(~/.migra.yaml 或 ./migra.yaml) > 默认值
#
# 环境变量通过 Viper 自动绑定，点分隔键转换为下划线分隔的大写形式
# 例如：diff.schemas → MIGRA_DIFF_SCHEMAS

# ========================
# 数据库连接
# ========================

# 默认数据库连接字符串
# 用于 diff 单参数模式：migra diff file.sql（此时 target 从此变量读取）
# 也用于 push 命令的目标数据库
MIGRA_DATABASE_URL=postgres://user:password@localhost:5432/dbname?sslmode=disable

# diff 零参数模式（migra diff）的来源与目标
# 当不传任何参数时，migra diff 会比较 source 与 target
MIGRA_DATABASE_SOURCE=postgres://localhost/db1
MIGRA_DATABASE_TARGET=postgres://localhost/db2

# ========================
# 比较选项（diff / push 共用）
# ========================

# 要比较的 Schema 列表，多个 schema 用逗号分隔
# 默认值：public
# 示例：MIGRA_DIFF_SCHEMAS=public,auth,api
MIGRA_DIFF_SCHEMAS=public

# 输出格式
# 可选值：sql | json
# 默认值：sql
MIGRA_DIFF_FORMAT=sql

# 是否允许破坏性 DROP 操作
# false：DROP 操作被过滤，仅输出警告
# true：允许输出/执行所有 DROP 操作
# 默认值：false
MIGRA_DIFF_UNSAFE_DROP=false

# 遇到不支持的语句时直接失败退出
# false：跳过并继续，仅输出警告
# true：直接报错退出
# 默认值：false
MIGRA_DIFF_STRICT=false

# ========================
# 输出选项
# ========================

# 输出文件路径（留空则输出到 stdout）
MIGRA_OUTPUT_FILE=

# ========================
# 全局选项
# ========================

# 配置文件路径
# 默认自动查找优先级：--config 参数 > ~/.migra.yaml > ./migra.yaml
# MIGRA_CONFIG=/path/to/custom/config.yaml

# 详细输出模式
# 开启后会在启动时打印正在使用的配置文件路径
# 默认值：false
# MIGRA_VERBOSE=true


# ============================================================
# 以下变量已定义在配置结构体中，但代码中暂未读取
# （为 YAML 配置文件保留的字段，环境变量绑定暂未实现）
# 如需使用，需在 DBLoader 或 app.Config 中补充读取逻辑
# ============================================================

# 连接池配置（database.pool.*）
# MIGRA_DATABASE_POOL_MAX_OPEN_CONNS=10
# MIGRA_DATABASE_POOL_MAX_IDLE_CONNS=5
# MIGRA_DATABASE_POOL_CONN_MAX_LIFETIME=1h

# 日志配置（logging.*）
# MIGRA_LOGGING_LEVEL=info    # debug | info | warn | error
# MIGRA_LOGGING_FORMAT=text   # text | json


# ============================================================
# PostgreSQL 标准环境变量（pgx 自动读取，无需 MIGRA_ 前缀）
# 当使用空连接字符串 postgres:// 时，pgx 自动读取以下变量
# ============================================================
# PGHOST=localhost
# PGPORT=5432
# PGUSER=myuser
# PGPASSWORD=mypassword
# PGDATABASE=mydb
# PGSSLMODE=disable
